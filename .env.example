# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL. Obligatorio.
# En Railway, referenciar el servicio de Postgres con ${{Postgres.DATABASE_URL}}
# para que resuelva a la URL interna (más rápida y sin costo de egress).
# En local: postgresql://posarca:posarca_dev@localhost:5432/posarca
DATABASE_URL=

# ── ARCA/AFIP ─────────────────────────────────────────────────────────────────
# Los certs se guardan en la DB por empresa (multi-tenant). Estas variables solo
# sirven para seedear la PRIMERA empresa al arrancar; después se administran en la
# app. En testing sin certs, ARCA corre en modo mock.
ARCA_CUIT=30712345678
ARCA_CERT_CONTENT=       # contenido PEM del certificado (no una ruta a archivo)
ARCA_KEY_CONTENT=        # contenido PEM de la clave privada
ARCA_ENV=testing         # testing | produccion
ARCA_PUNTO_VENTA=1

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=          # obtener en https://resend.com
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=PosArca Fiscal

# ── Alertas de operación ──────────────────────────────────────────────────────
# Email que recibe avisos del sistema (ej. comprobantes que no consiguen CAE tras
# varios intentos). Vacío = sin alertas.
ALERT_EMAIL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Auth ──────────────────────────────────────────────────────────────────────
# Obligatorio, sin default. Generar con: openssl rand -hex 32
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (sin espacios).
# En producción, el dominio de Vercel del frontend (ej. https://posarca.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Multi-tenant / admin ──────────────────────────────────────────────────────
# INVITE_CODE: si está seteado, habilita registro con código. Vacío = solo 1 cuenta.
# ADMIN_SECRET: si está seteado, habilita el panel de admin (header X-Admin-Secret).
INVITE_CODE=
ADMIN_SECRET=
